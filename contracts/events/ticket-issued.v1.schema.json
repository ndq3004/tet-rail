{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket issued v1",
  "allOf": [{ "$ref": "event-envelope.v1.schema.json" }],
  "properties": {
    "event_type": { "const": "TicketIssued.v1" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["ticket_id", "order_id", "order_item_id"],
      "properties": {
        "ticket_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "order_item_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
