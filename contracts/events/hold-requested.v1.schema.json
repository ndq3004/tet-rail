{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetrail.local/contracts/events/hold-requested.v1.schema.json",
  "title": "Booking hold command v1",
  "type": "object",
  "required": ["request_id", "owner_id", "idempotency_key", "correlation_id", "expires_at", "segments"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "owner_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "expires_at": { "type": "string", "format": "date-time" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["trip_id", "carriage_id", "seat_id", "segment_index"],
        "properties": {
          "trip_id": { "type": "string", "format": "uuid" },
          "carriage_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "seat_id": { "type": "string", "format": "uuid" },
          "segment_index": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
