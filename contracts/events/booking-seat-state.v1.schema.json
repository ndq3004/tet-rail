{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tetrail.local/contracts/events/booking-seat-state.v1.schema.json",
  "title": "Booking seat-state projection event v1",
  "type": "object",
  "required": ["event_id", "event_type", "version", "occurred_at", "correlation_id", "causation_id", "source_position", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "enum": ["SeatHeld.v1", "HoldExpired.v1", "HoldConfirmed.v1"] },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": "string", "format": "uuid" },
    "source_position": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "required": ["trip_id", "seat_id", "segment_indices"],
      "properties": {
        "trip_id": { "type": "string", "format": "uuid" },
        "seat_id": { "type": "string", "format": "uuid" },
        "segment_indices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
