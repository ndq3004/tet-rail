{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogPostgres": "Host=localhost;Port=5432;Database=tetrail;Username=tetrail;Password=tetrail-local-only;Search Path=catalog",
    "Redis": "localhost:6379,abortConnect=false,connectRetry=0,connectTimeout=500,asyncTimeout=500,syncTimeout=500"
  },
  "TripSearch": {
    "CacheTtlSeconds": 60,
    "AvailabilityStaleAfterSeconds": 120
  },
  "SeatMap": {
    "CacheTtlSeconds": 15,
    "StaleAfterSeconds": 60
  }
  ,
  "SeatProjectionKafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "booking.seat-state.v1",
    "DeadLetterTopic": "catalog.seat-projection.v1.dlq",
    "ConsumerGroup": "catalog-seat-projection-v1",
    "MaxDeliveryAttempts": 3,
    "RetryBaseDelayMilliseconds": 100
  }
}
